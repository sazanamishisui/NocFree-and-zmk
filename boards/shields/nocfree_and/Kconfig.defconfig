# SPDX-License-Identifier: MIT

if SHIELD_NOCFREE_AND_DONGLE

config ZMK_KEYBOARD_NAME
    default "NocFree &"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_SPLIT
    default y

# Left, right and NocFree Pad all connect directly to the dongle.
config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 3

# Three split peripherals + the usual five host Bluetooth profiles.
config BT_MAX_CONN
    default 8

config BT_MAX_PAIRED
    default 8

endif
