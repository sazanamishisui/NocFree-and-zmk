# SPDX-License-Identifier: MIT

if SHIELD_NOCFREE_AND_DONGLE

config ZMK_KEYBOARD_NAME
    default "NocFree &"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_SPLIT
    default y

# Left and right NocFree halves both connect directly to the dongle.
config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2

# Two split peripherals + the usual five host Bluetooth profiles.
config BT_MAX_CONN
    default 7

config BT_MAX_PAIRED
    default 7

endif
