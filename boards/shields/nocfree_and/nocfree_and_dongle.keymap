/*
 * SPDX-License-Identifier: MIT
 *
 * Dongle-central keymap derived from electricdoc187/NocFree-and-zmk jis-studio.
 * Base and Fn are intentionally kept behavior-for-behavior compatible. Four
 * additional transparent layers are preallocated for ZMK Studio editing.
 */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    macros {
        /*
         * Select the requested host profile before preferring BLE output.
         * Keeping one macro per profile avoids depending on parameterized
         * macro support and makes every action visible to ZMK Studio.
         */
        ble_profile_1: ble_profile_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0>, <&out OUT_BLE>;
        };

        ble_profile_2: ble_profile_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1>, <&out OUT_BLE>;
        };

        ble_profile_3: ble_profile_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2>, <&out OUT_BLE>;
        };

        ble_profile_4: ble_profile_4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3>, <&out OUT_BLE>;
        };

        ble_profile_5: ble_profile_5 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 4>, <&out OUT_BLE>;
        };
    };

    behaviors {
        bootloader_hold: bootloader_hold {
            compatible = "zmk,behavior-hold-tap";
            label = "BOOTLOADER_HOLD";
            bindings = <&bootloader>, <&sys_reset>;
            #binding-cells = <2>;
            tapping-term-ms = <1500>;
            flavor = "tap-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
                /* Function row */
                &kp ESC   &kp F1    &kp F2    &kp F3    &kp F4    &kp F5    &kp F6
                &kp F7    &kp F8    &kp F9    &kp F10   &kp F11   &kp F12   &kp PSCRN &kp HOME
                /* Number row. GRAVE is on the physical Hankaku/Zenkaku key. */
                &kp GRAVE &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &kp N6
                &kp N7    &kp N8    &kp N9    &kp N0    &kp MINUS &kp EQUAL &kp INT_YEN &kp BSPC
                /* QWERTY row */
                &kp TAB   &kp Q     &kp W     &kp E     &kp R     &kp T
                &kp Y     &kp U     &kp I     &kp O     &kp P     &kp LBKT &kp RBKT &kp DEL
                /* Home row */
                &kp CAPS  &kp A     &kp S     &kp D     &kp F     &kp G
                &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp SQT &kp BSLH &kp RET
                /* Shift row */
                &kp LSHFT &kp Z     &kp X     &kp C     &kp V     &kp B
                &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp INT_RO &kp RSHFT &kp UP
                /* Bottom row: tap Muhenkan / hold Fn, plus a separate Fn key. */
                &kp LCTRL &kp LGUI       &kp LALT &lt 1 INT_MUHENKAN &kp SPACE
                &kp SPACE &kp INT_HENKAN &kp RALT &mo 1              &kp RCTRL
                &kp LEFT  &kp DOWN       &kp RIGHT
            >;
        };

        function_layer {
            display-name = "Fn";
            bindings = <
                /* Function row */
                &bootloader_hold 0 0 &kp C_BRIGHTNESS_DEC &kp C_BRIGHTNESS_INC &trans &trans &trans &trans
                &kp C_PREV &kp C_PP &kp C_NEXT &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &trans &trans
                /* Number row */
                &trans &ble_profile_1 &ble_profile_2 &ble_profile_3 &ble_profile_4 &ble_profile_5 &studio_unlock
                &trans &trans &trans &bt BT_CLR &trans &trans &trans &trans
                /* QWERTY row */
                &trans &trans &trans &trans &trans &trans
                &trans &out OUT_USB &trans &trans &trans &trans &trans &bootloader_hold 0 0
                /* Home row */
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans
                /* Shift row */
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans
                /* Bottom row */
                &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };

        navigation_layer {
            display-name = "Nav";
            status = "reserved";
            bindings = <
                /* Function row */
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans
                /* Number row */
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans
                /* QWERTY row */
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                /* Home row */
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                /* Shift row */
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                /* Bottom row */
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans
            >;
        };

        numpad_layer {
            display-name = "Numpad";
            status = "reserved";
            bindings = <
                /* Function row */
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans
                /* Number row */
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans
                /* QWERTY row */
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                /* Home row */
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                /* Shift row */
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                /* Bottom row */
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans
            >;
        };

        work_layer {
            display-name = "Work";
            status = "reserved";
            bindings = <
                /* Function row */
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans
                /* Number row */
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans
                /* QWERTY row */
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                /* Home row */
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                /* Shift row */
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                /* Bottom row */
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans
            >;
        };

        reserved_layer {
            display-name = "Reserved";
            status = "reserved";
            bindings = <
                /* Function row */
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans
                /* Number row */
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans
                /* QWERTY row */
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                /* Home row */
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                /* Shift row */
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                /* Bottom row */
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans
            >;
        };
    };
};
