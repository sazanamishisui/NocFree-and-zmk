/*
 * SPDX-License-Identifier: MIT
 *
 * Dongle-central keymap derived from electricdoc187/NocFree-and-zmk jis-studio.
 * Base and Fn are intentionally kept behavior-for-behavior compatible. Four
 * additional transparent layers are preallocated for ZMK Studio editing.
 */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    behaviors {
        /*
         * Parameters 0-4 select a BLE profile and switch output after a short
         * non-blocking delay. Parameter 5 cancels a pending BLE switch and
         * selects USB.
         */
        bt_out: bt_output {
            compatible = "nocfree,behavior-bt-output";
            label = "BT_OUTPUT";
            #binding-cells = <1>;
        };

        bootloader_hold: bootloader_hold {
            compatible = "zmk,behavior-hold-tap";
            label = "BOOTLOADER_HOLD";
            bindings = <&bootloader>, <&sys_reset>;
            #binding-cells = <2>;
            tapping-term-ms = <1500>;
            flavor = "tap-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
                /* Function row */
                &kp ESC   &kp F1    &kp F2    &kp F3    &kp F4    &kp F5    &kp F6
                &kp F7    &kp F8    &kp F9    &kp F10   &kp F11   &kp F12   &kp PSCRN &kp HOME
                /* Number row. GRAVE is on the physical Hankaku/Zenkaku key. */
                &kp GRAVE &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &kp N6
                &kp N7    &kp N8    &kp N9    &kp N0    &kp MINUS &kp EQUAL &kp INT_YEN &kp BSPC
                /* QWERTY row */
                &kp TAB   &kp Q     &kp W     &kp E     &kp R     &kp T
                &kp Y     &kp U     &kp I     &kp O     &kp P     &kp LBKT &kp RBKT &kp DEL
                /* Home row */
                &kp CAPS  &kp A     &kp S     &kp D     &kp F     &kp G
                &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp SQT &kp BSLH &kp RET
                /* Shift row */
                &kp LSHFT &kp Z     &kp X     &kp C     &kp V     &kp B
                &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp INT_RO &kp RSHFT &kp UP
                /* Bottom row: tap Muhenkan / hold Fn, plus a separate Fn key. */
                &kp LCTRL &kp LGUI       &kp LALT &lt 1 INT_MUHENKAN &kp SPACE
                &kp SPACE &kp INT_HENKAN &kp RALT &mo 1              &kp RCTRL
                &kp LEFT  &kp DOWN       &kp RIGHT
            >;
        };

        function_layer {
            display-name = "Fn";
            bindings = <
                /* Function row */
                &bootloader_hold 0 0 &kp C_BRIGHTNESS_DEC &kp C_BRIGHTNESS_INC &trans &trans &trans &trans
                &kp C_PREV &kp C_PP &kp C_NEXT &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &trans &trans
                /* Number row */
                &trans &bt_out 0 &bt_out 1 &bt_out 2 &bt_out 3 &bt_out 4 &studio_unlock
                &trans &trans &trans &bt BT_CLR &trans &trans &trans &trans
                /* QWERTY row */
                &trans &trans &trans &trans &trans &trans
                &trans &bt_out 5 &trans &trans &trans &trans &trans &bootloader_hold 0 0
                /* Home row */
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans
                /* Shift row */
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans
                /* Bottom row */
                &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };

        navigation_layer {
            display-name = "Nav";
            status = "reserved";
            bindings = <
                /* Function row */
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans
                /* Number row */
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans
                /* QWERTY row */
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                /* Home row */
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                /* Shift row */
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                /* Bottom row */
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans
            >;
        };

        numpad_layer {
            display-name = "Numpad";
            status = "reserved";
            bindings = <
                /* Function row */
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans
                /* Number row */
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans
                /* QWERTY row */
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                /* Home row */
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                /* Shift row */
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                /* Bottom row */
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans
            >;
        };

        work_layer {
            display-name = "Work";
            status = "reserved";
            bindings = <
                /* Function row */
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans
                /* Number row */
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans
                /* QWERTY row */
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                /* Home row */
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                /* Shift row */
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                /* Bottom row */
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans
            >;
        };

        reserved_layer {
            display-name = "Reserved";
            status = "reserved";
            bindings = <
                /* Function row */
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans
                /* Number row */
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans
                /* QWERTY row */
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                /* Home row */
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                /* Shift row */
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                /* Bottom row */
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans
            >;
        };
    };
};
