/*
 * SPDX-License-Identifier: MIT
 *
 * Keyless ZMK split central for NocFree & JIS.
 */
#include <dt-bindings/zmk/matrix_transform.h>
#include "nocfree_and-layouts.dtsi"

/ {
    chosen {
        zmk,kscan = &mock_kscan;
        zmk,physical-layout = &ansi_layout;
    };

    /*
     * This must be identical to the JIS transform on both NocFree halves.
     * Global positions 0-36 originate on the left and 37-84 on the right.
     */
    matrix_transform0: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        rows = <1>;
        columns = <85>;
        map = <
            /* Function row */
            RC(0,0)  RC(0,1)  RC(0,2)  RC(0,3)  RC(0,4)  RC(0,5)  RC(0,6)
            RC(0,37) RC(0,38) RC(0,39) RC(0,40) RC(0,41) RC(0,42) RC(0,43) RC(0,44)
            /* Number row */
            RC(0,7)  RC(0,8)  RC(0,9)  RC(0,10) RC(0,11) RC(0,12) RC(0,13)
            RC(0,45) RC(0,46) RC(0,47) RC(0,48) RC(0,49) RC(0,50) RC(0,51) RC(0,52)
            /* Tab row */
            RC(0,14) RC(0,15) RC(0,16) RC(0,17) RC(0,18) RC(0,19)
            RC(0,53) RC(0,54) RC(0,55) RC(0,56) RC(0,57) RC(0,58) RC(0,59) RC(0,60)
            /* Home row */
            RC(0,20) RC(0,21) RC(0,22) RC(0,23) RC(0,24) RC(0,25)
            RC(0,61) RC(0,62) RC(0,63) RC(0,64) RC(0,65) RC(0,66) RC(0,67) RC(0,68)
            /* Shift row */
            RC(0,26) RC(0,27) RC(0,28) RC(0,29) RC(0,30) RC(0,31)
            RC(0,69) RC(0,70) RC(0,71) RC(0,72) RC(0,73) RC(0,74) RC(0,75) RC(0,76)
            /* Bottom row */
            RC(0,32) RC(0,33) RC(0,34) RC(0,35) RC(0,36)
            RC(0,77) RC(0,78) RC(0,79) RC(0,80) RC(0,81) RC(0,82) RC(0,83) RC(0,84)
        >;
    };

    /* The USB dongle has no physical keys of its own. */
    mock_kscan: mock_kscan_0 {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };
};
