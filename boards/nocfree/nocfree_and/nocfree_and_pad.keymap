#include <behaviors.dtsi>

/ {
    keymap {
        compatible = "zmk,keymap";

        /*
         * Split peripherals report positions to the dongle and do not execute
         * this map. A full map is supplied so the board validates by itself.
         */
        default_layer {
            bindings = <
                /* NocFree & positions 0-84. */
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans
                /* NocFree Pad positions 85-105. */
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans
            >;
        };
    };
};
