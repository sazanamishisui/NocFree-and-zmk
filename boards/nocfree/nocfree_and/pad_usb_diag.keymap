/*
 * SPDX-License-Identifier: MIT
 *
 * Temporary standalone USB-HID wiring probe for the NocFree Pad.
 *
 * PCA 0x20 bits 0-15 emit A-P. PCA 0x22 bits 0-9 emit Q-Z, and bits
 * 10-15 emit 1-6. Pressing the physical keys in reading order therefore
 * reveals the exact expander/bit wiring without assuming a factory layout.
 */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                /* PCA 0x20 bits 0-15. */
                &kp A &kp B &kp C &kp D &kp E &kp F &kp G &kp H
                &kp I &kp J &kp K &kp L &kp M &kp N &kp O &kp P

                /* PCA 0x22 bits 0-15. */
                &kp Q &kp R &kp S &kp T &kp U &kp V &kp W &kp X
                &kp Y &kp Z &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6
            >;
        };
    };
};
